# Minimal Emberstage contribution-ingest configuration.
# Keep the HTTP control plane and this RTMP listener on the same host so callback
# traffic stays on loopback. Replace paths/limits to match the deployment.

worker_processes auto;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;
            notify_method post;

            # Only local relay workers may pull the accepted contribution.
            # The public side is publish-only; viewers use the configured
            # destination platforms rather than this origin.
            allow play 127.0.0.1;
            allow play ::1;
            deny play all;

            # A non-2xx response rejects the OBS publisher. The callback starts
            # destination relays only after the contribution key is accepted.
            on_publish http://127.0.0.1:3000/api/streams/publish;
            on_publish_done http://127.0.0.1:3000/api/streams/publish_done;
        }
    }
}

http {
    server {
        listen 127.0.0.1:8080;
        location /healthz {
            return 200 "ok\n";
        }
    }
}

# nginx-rtmp listens for plain RTMP. Do not expose port 1935 publicly and call
# it RTMPS. Production RTMPS requires a separately configured TLS terminator
# (for example HAProxy or stunnel) in front of this listener.
