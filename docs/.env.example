# Emberstage Control-Plane Environment Settings

# Server port
PORT=3000

# SQLite database file or ':memory:' for tests
DATABASE_URL=emberstage.db

# Master encryption secret used for encrypting custom target secrets (must be 32 bytes or longer)
ENCRYPTION_SECRET=your-random-32-byte-master-secret-key-goes-here!

# Base URL for the public-facing Emberstage web console
APP_BASE_URL=https://console.emberstage.com

# ==============================================================================
# Managed-Streaming & Relay Workers Ingest/FFmpeg Settings
# ==============================================================================

# Local NGINX-RTMP contribution ingest server endpoint
# Live relay workers connect here to pull contribution streams
CONTRIBUTION_INGEST_URL=rtmp://localhost/live

# Public RTMP ingest server provided to paired devices/docks
# These are short-lived credentials shown after starting a session
RTMP_INGEST_BASE_URL=rtmp://ingest.emberstage.com/live

# Path to the ffmpeg executable.
# Set this to a absolute path (e.g. C:\ffmpeg\ffmpeg.exe on Windows, or /usr/bin/ffmpeg on Linux/macOS)
FFMPEG_PATH=ffmpeg

# When set to true, disables actual child process spawns for ffmpeg.
# Excellent for dry-running, dev environments, or local testing without NGINX/FFmpeg.
FAKE_WORKERS=false

# ==============================================================================
# Note on OBS Integration
# ==============================================================================
# The Emberstage OBS installers (install-media-deck.ps1 and install-media-deck.py)
# ONLY register and configure the OBS custom browser docks (including "Emberstage - Streaming").
#
# IMPORTANT:
# - The installer DOES NOT alter OBS stream settings.
# - The installer DOES NOT start streaming automatically in OBS.
# - The user/operator must manually paste the short-lived contribution credentials
#   (Server and Stream Key) into OBS Stream Settings (Service: "Custom...") and click "Start Streaming".
# - Start from docs/nginx-rtmp.conf.example for the ingest callbacks.
# - nginx-rtmp is plain RTMP; production RTMPS needs a TLS terminator in front of it.
