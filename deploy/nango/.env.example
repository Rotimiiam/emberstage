# Generate once and retain securely. Changing this key makes stored OAuth tokens unreadable.
NANGO_ENCRYPTION_KEY=
NANGO_DB_PASSWORD=
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=

# Replace with HTTPS URLs when deployed behind a reverse proxy.
NANGO_SERVER_URL=http://127.0.0.1:3003
NANGO_PUBLIC_SERVER_URL=http://127.0.0.1:3003
NANGO_PUBLIC_CONNECT_URL=http://127.0.0.1:3009
