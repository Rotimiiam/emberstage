# Emberstage Server Configuration Environment Variables
PORT=3000
HOST=127.0.0.1
DATABASE_URL=emberstage.db
APP_BASE_URL=http://127.0.0.1:3000

# Server master secret for encrypting third-party integration tokens
ENCRYPTION_SECRET=

# Google OIDC Auth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Auth0 Auth Configuration
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=

# Self-hosted Nango. Use the environment secret key shown in Nango Settings.
NANGO_BASE_URL=http://127.0.0.1:3003
NANGO_SECRET_KEY=
NANGO_TWITCH_INTEGRATION_ID=twitch
NANGO_YOUTUBE_INTEGRATION_ID=youtube
NANGO_FACEBOOK_INTEGRATION_ID=facebook
FACEBOOK_API_VERSION=v25.0

# Twitch Integration (OAuth credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# Paystack Billing (use test-mode values for local verification)
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
# Amount in the currency subunit (for NGN, kobo). The plan amount takes precedence.
PAYSTACK_PLAN_AMOUNT=
PAYSTACK_CURRENCY=NGN

# Managed streaming. Keep the local ingest URL loopback-only; expose the public
# ingest endpoint through an RTMPS-capable TLS proxy in production.
CONTRIBUTION_INGEST_URL=rtmp://127.0.0.1/live
RTMP_INGEST_BASE_URL=rtmp://127.0.0.1/live
FFMPEG_PATH=ffmpeg
FAKE_WORKERS=false
